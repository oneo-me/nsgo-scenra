design device=phone name="Phone/Discover"
box class="flex-1 bg-zinc-50"
  use status-bar
  box class="flex-row items-center justify-between px-5 pt-3"
    box class="gap-0.5"
      text "Good evening, Ari" class="text-xs text-zinc-400"
      text "Discover" class="text-2xl font-bold tracking-tight text-zinc-900"
    end
    box class="size-9 items-center justify-center rounded-full bg-linear-to-br from-rose-400 to-amber-300"
      text "A" class="text-xs font-semibold text-white"
    end
  end
  box class="mx-5 mt-3 h-10 flex-row items-center gap-2 rounded-full bg-white px-4 shadow-sm"
    icon search class="size-4 text-zinc-400"
    text "Search songs, artists, playlists" class="text-sm text-zinc-400"
  end
  box class="mt-3 flex-row gap-2 px-5"
    use chip variant=selected label="For You"
    use chip label="Charts"
    use chip label="Playlists"
    use chip label="Radio"
    use chip label="Artists"
  end
  box class="mx-5 mt-4 h-32 flex-row items-center justify-between rounded-2xl bg-linear-to-br from-rose-500 to-fuchsia-500 px-4" tap="open mobile-now-playing" note="Tap to play the 30-song daily mix, shuffled"
    box class="gap-1"
      text "DAILY MIX" class="text-[10px] font-semibold tracking-[0.18em] text-white/70"
      text "30 songs, just for you" class="text-lg font-bold text-white"
      text "No ads · Saves offline" class="text-[11px] text-white/70"
    end
    image "Daily mix cover, morning light" src="assets/morning-light.jpg" class="size-20 rounded-xl shadow-lg"
  end
  box class="mt-4 gap-2 px-5"
    use section-header variant=compact more-label="More"
    box class="flex-row gap-3" note="A playlist card opens the playlist; a song in it opens the player"
      use playlist-card variant=compact class="flex-1" meta="124K plays"
      use playlist-card variant=compact class="flex-1" cover="Playlist cover, subway platform" cover.src="assets/subway.jpg" title="Commute Beats" meta="87K plays"
    end
    box class="flex-row gap-3"
      use playlist-card variant=compact class="flex-1" cover="Playlist cover, rainy window" cover.src="assets/rainy-window.jpg" title="Folk for Rainy Days" meta="219K plays"
      use playlist-card variant=compact class="flex-1" cover="Playlist cover, old turntable" cover.src="assets/turntable.jpg" title="Old Jazz & Whiskey" meta="63K plays"
    end
  end
  use mini-player class="mx-4 mt-auto" player.tap="open mobile-now-playing" note="Tap or swipe up to open the player"
  use tab-bar class="mt-2" discover.tap="open mobile-discover"
end
